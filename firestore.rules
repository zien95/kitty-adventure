rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid}/saves/current {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schema', 'payload', 'revision', 'updatedAt', 'appVersion'])
        && request.resource.data.schema == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 800000
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.appVersion is string;
    }
  }
}
